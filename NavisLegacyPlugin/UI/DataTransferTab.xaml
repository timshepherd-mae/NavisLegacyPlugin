<UserControl x:Class="NavisLegacyPlugin.UI.DataTransferTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NavisLegacyPlugin.Converters"
             DataContext="{Binding DataPainting}">
    <UserControl.Resources>
        <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Data Transfer" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Guided external-to-live transfer" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Clear" Width="80" Height="26" VerticalAlignment="Top"
                        Command="{Binding ClearExternalTransferCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
            </Grid>

            <GroupBox Header="1. SOURCE" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <TextBlock Text="External Navisworks file" FontWeight="Bold"/>
                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ExternalSourceFilePath}" IsReadOnly="True" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Browse..." Width="90" Margin="6,0,0,0"
                                Command="{Binding BrowseExternalSourceFileCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                    </Grid>
                    <TextBlock Text="SOURCE Selection Set" FontWeight="Bold"/>
                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ExternalExportSetName}" IsReadOnly="True"
                                 ToolTip="Selection Set beneath MAE-4D / DATA-TRANSFER / EXPORT in the external source file"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Edit..." Width="90" Margin="6,0,0,0"
                                Command="{Binding EditExternalExportSetNameCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                ToolTip="Open the standard input dialog to type the Selection Set name"/>
                    </Grid>
                    <TextBlock Text="Resolution" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <RadioButton GroupName="B1SourceResolution" Content="All" Margin="0,0,12,0" IsChecked="{Binding SourceResolutionType, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=All}"/>
                        <RadioButton GroupName="B1SourceResolution" Content="Branch" Margin="0,0,12,0" IsChecked="{Binding SourceResolutionType, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Branch}"/>
                        <RadioButton GroupName="B1SourceResolution" Content="Leaf" IsChecked="{Binding SourceResolutionType, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Leaf}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="2. TARGET" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <TextBlock Text="Live in-session TARGET population" FontWeight="Bold"/>
                    <TextBlock Text="TARGET is resolved from the existing MAE-4D / DATA-TRANSFER / TARGET Selection Set semantics." TextWrapping="Wrap" Margin="0,4,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="B1TargetResolution" Content="All" Margin="0,0,12,0" IsChecked="{Binding TargetResolutionType, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=All}"/>
                        <RadioButton GroupName="B1TargetResolution" Content="Branch" Margin="0,0,12,0" IsChecked="{Binding TargetResolutionType, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Branch}"/>
                        <RadioButton GroupName="B1TargetResolution" Content="Leaf" IsChecked="{Binding TargetResolutionType, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Leaf}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="3. MATCHING" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="260"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Matching Strategy" VerticalAlignment="Center" FontWeight="Bold"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding MatchingStrategyOptions}" SelectedItem="{Binding MatchingStrategy, Mode=TwoWay}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="260"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Anchor Method" VerticalAlignment="Center" FontWeight="Bold"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AnchorMethodOptions}" SelectedItem="{Binding AnchorMethod, Mode=TwoWay}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                    </Grid>
                    <TextBlock Text="{Binding MatchingStrategyExplanation}" Margin="0,5,0,0" Foreground="DimGray" TextWrapping="Wrap"/>
                    <TextBlock Text="When enabled, GUID-only matches are not accepted until verified by a later file-aware strategy."
                               TextWrapping="Wrap" Margin="20,4,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="4. DATA TO TRANSFER" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <TextBlock Text="Existing ExecuteSignature-backed transfer instructions are retained and will be integrated here in Phase 6.5B2." TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="5. TRANSFER OPTIONS" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <CheckBox Content="Overwrite existing values" IsChecked="{Binding Overwrite, Mode=TwoWay}"/>
                    <TextBlock Text="All options on this tab share the same DataPaintingViewModel state as the existing Data Painting tab." TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="6. Execute / 7. Results">
                <StackPanel Margin="8">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Validate" Width="95" Margin="0,0,8,0"
                                Command="{Binding ValidateExternalTransferCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                        <Button Content="Execute Transfer" Width="130"
                                Command="{Binding TransferExternalSourceCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,6"/>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="18"/>
                    <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <GroupBox Header="Transfer accounting" Margin="0,0,0,8">
                        <StackPanel Margin="8">
                            <TextBlock Text="Every SOURCE item is shown once in the outcome flow." FontWeight="Bold"/>
                            <TextBlock Text="Follow the branches to see matching, RID coverage and write results without mixing denominators." TextWrapping="Wrap" Margin="0,2,0,10" Foreground="DimGray"/>
                            <Border Background="#E8F1FB" BorderBrush="#7A9CC6" BorderThickness="1" CornerRadius="4" Padding="10">
                                <StackPanel HorizontalAlignment="Center"><TextBlock Text="SOURCE items" FontWeight="Bold"/><TextBlock Text="{Binding LastSourceItems}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
                            </Border>
                            <TextBlock Text="↓" FontSize="20" HorizontalAlignment="Center" Margin="0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#E8F5E9" BorderBrush="#79A77C" BorderThickness="1" CornerRadius="4" Padding="8"><StackPanel><TextBlock Text="Matched to TARGET" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding LastMatched}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Border>
                                <Border Grid.Column="2" Background="#FDECEC" BorderBrush="#C98A8A" BorderThickness="1" CornerRadius="4" Padding="8"><StackPanel><TextBlock Text="Unresolved" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding LastUnmatched}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Border>
                            </Grid>
                            <TextBlock Text="Each branch is split by transferable RID availability." HorizontalAlignment="Center" Margin="0,8" Foreground="DimGray"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#DFF3E3" BorderBrush="#79A77C" BorderThickness="1" CornerRadius="4" Padding="7"><StackPanel><StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Matched" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="with RID" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel><TextBlock Text="{Binding LastMatchedTransferableRids}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="eligible to write" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Border>
                                <Border Grid.Column="2" Background="#FFF4D7" BorderBrush="#C9A85C" BorderThickness="1" CornerRadius="4" Padding="7"><StackPanel><StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Matched" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="no RID" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel><TextBlock Text="{Binding LastMatchedWithoutTransferableRid}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="no write required" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Border>
                                <Border Grid.Column="4" Background="#FCE2CE" BorderBrush="#C98D5C" BorderThickness="1" CornerRadius="4" Padding="7"><StackPanel><StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Unresolved" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="with RID" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel><TextBlock Text="{Binding LastUnresolvedTransferableRids}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="needs review" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Border>
                                <Border Grid.Column="6" Background="#EEEEEE" BorderBrush="#999999" BorderThickness="1" CornerRadius="4" Padding="7"><StackPanel><StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Unresolved" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="no RID" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel><TextBlock Text="{Binding LastUnresolvedWithoutTransferableRid}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="no write possible" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Border>
                            </Grid>
                            <Border Background="#EEF0FF" BorderBrush="#858BC4" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,10,0,8">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="Transferable RIDs" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding LastTransferableRids}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Found TARGET" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding LastMatchedTransferableRids}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Need review" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding LastUnresolvedTransferableRids}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
                                </Grid>
                            </Border>
                            <GroupBox Header="Write result"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="Written" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding LastWritten}" FontSize="18" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Skipped" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding LastSkipped}" FontSize="18" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Failed" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding LastFailed}" FontSize="18" HorizontalAlignment="Center"/></StackPanel>
                            </Grid></GroupBox>
                            <GroupBox Header="Topology resolution" Margin="0,10,0,0"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="Applicable" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding LastTopologyApplicable}" FontSize="18" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Good" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding LastTopologyGood}" FontSize="18" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Vague" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding LastTopologyVague}" FontSize="18" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Grid.Column="3"><TextBlock Text="Ambiguous" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding LastTopologyAmbiguous}" FontSize="18" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="Unresolved" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding LastTopologyUnresolved}" FontSize="18" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Grid.Column="5"><TextBlock Text="Conflict" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding LastTopologyConflict}" FontSize="18" HorizontalAlignment="Center"/></StackPanel>
                            </Grid></GroupBox>
                            <GroupBox Header="Topology outcomes" Margin="0,10,0,0"><StackPanel Margin="8"><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="Filter" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox Width="150" ItemsSource="{Binding TopologyReviewFilterOptions}" SelectedItem="{Binding TopologyReviewFilter}"/><Button Content="Copy Visible Rows" Width="130" Margin="10,0,0,0" Command="{Binding CopyTopologyReviewCommand}"/><Button Content="Select TARGET" Width="110" Margin="6,0,0,0" Command="{Binding SelectTopologyTargetCommand}"/></StackPanel>
                                <DataGrid ItemsSource="{Binding TopologyReviewRows}" SelectedItem="{Binding SelectedTopologyReviewRow}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="200" MaxHeight="420" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns>
                                    <DataGridTextColumn Header="SOURCE row" Binding="{Binding SourceRowIndex}"/><DataGridTextColumn Header="SOURCE owner" Binding="{Binding SourceOwner}" Width="150"/><DataGridTextColumn Header="RID" Binding="{Binding RidValue}" Width="110"/><DataGridTextColumn Header="Strategy" Binding="{Binding MatchingStrategy}"/><DataGridTextColumn Header="Anchor" Binding="{Binding AnchorMethod}" Width="140"/><DataGridTextColumn Header="Anchor status" Binding="{Binding AnchorStatus}"/><DataGridTextColumn Header="Anchor key" Binding="{Binding AnchorKey}" Width="160"/><DataGridTextColumn Header="Classification" Binding="{Binding Status}"/><DataGridCheckBoxColumn Header="Conflict" Binding="{Binding Conflict}"/><DataGridTextColumn Header="Best" Binding="{Binding BestScore}"/><DataGridTextColumn Header="Next" Binding="{Binding NextBestScore}"/><DataGridTextColumn Header="Separation" Binding="{Binding Separation}"/><DataGridTextColumn Header="TARGET owner" Binding="{Binding TargetOwner}" Width="150"/><DataGridTextColumn Header="Operation" Binding="{Binding OperationStatus}"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="260"/>
                                </DataGrid.Columns></DataGrid></StackPanel></GroupBox>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
