<UserControl x:Class="NavisLegacyPlugin.UI.DataPaintingTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NavisLegacyPlugin"
             xmlns:conv="clr-namespace:NavisLegacyPlugin.Converters"
			 DataContext="{Binding DataPainting}">

	<UserControl.Resources>
		<conv:DoubleFormatConverter x:Key="DoubleFormatConverter" />
		<conv:EqualsConverter x:Key="EqualsConverter" />
		<conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
	</UserControl.Resources>


	<Grid Margin="10">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>			<!-- Mode -->
			<RowDefinition Height="Auto"/>			<!-- Write -->
			<RowDefinition Height="Auto"/>			<!-- GetData -->
			<RowDefinition Height="Auto"/>			<!-- Transfer RID -->
			<RowDefinition Height="Auto"/>			<!-- Progress bar -->
			<RowDefinition Height="Auto"/>			<!-- Progress text -->
			<RowDefinition Height="Auto"/>			<!-- Status -->
		</Grid.RowDefinitions>

		<!-- Write Mode -->
		<StackPanel Grid.Row="0"
                Orientation="Horizontal"
                Margin="0,0,0,10">

			<TextBlock Text="Write to:"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0"/>


			
			<RadioButton Content="Branch"
                     GroupName="WriteTarget"
                     IsChecked="{Binding WriteMode, Converter={StaticResource EqualsConverter}, ConverterParameter=Branch}"
                     Margin="0,0,10,0"/>

			<RadioButton Content="Leaf"
                     GroupName="WriteTarget"
                     IsChecked="{Binding WriteMode, Converter={StaticResource EqualsConverter}, ConverterParameter=Leaf}"/>
			
		</StackPanel>

		<!-- Existing button -->
		<Button Grid.Row="1"
            Content="Write Test Property"
            Width="160"
            Command="{Binding WriteTestCommand}"
				IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}	}"/>

		<!-- Get Synchro Data button -->
		<Button Grid.Row="2"
            Content="Get Synchro Data"
            Width="160"
            Margin="0,10,0,0"
            Command="{Binding GetSynchroDataCommand}"
				IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}	}"/>

		<Button Grid.Row="3"
			Content="Transfer RID A → B"
			Width="160"
			Margin="0,10,0,0"
			Command="{Binding TransferRidCommand}"
				IsEnabled="{Binding CanTransferRid}" />
		
		
		<!-- Progress bar -->
		<ProgressBar Grid.Row="4"
				 Height="18"
				 Margin="0,10,0,0"
				 Minimum="0"
				 Maximum="100"
				 Value="{Binding ProgressPercent}" />

		<!-- Progress text -->
		<TextBlock Grid.Row="5"
			   Margin="0,6,0,0"
			   Text="{Binding ProgressText}" />

		<!-- Status -->
		<TextBlock Grid.Row="6"
               Margin="0,10,0,0"
               Text="{Binding Status}" />


	</Grid>
	
</UserControl>
