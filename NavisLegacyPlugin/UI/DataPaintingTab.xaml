<UserControl x:Class="NavisLegacyPlugin.UI.DataPaintingTab"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 
			xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
			xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"	
			xmlns:conv="clr-namespace:NavisLegacyPlugin.Converters" 
            xmlns:local="clr-namespace:NavisLegacyPlugin"
			DataContext="{Binding DataPainting}">

	<UserControl.Resources>
		<conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
		<conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
	</UserControl.Resources>

	<Grid Margin="10">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>			<!-- Model Depth -->
			<RowDefinition Height="Auto"/>			<!-- Overwrite -->
			<RowDefinition Height="Auto"/>			<!-- Get Model Collections -->
			<RowDefinition Height="Auto"/>			<!-- Write Test -->
			<RowDefinition Height="Auto"/>			<!-- GetData -->
			<RowDefinition Height="Auto"/>			<!-- Transfer RID -->
			<RowDefinition Height="Auto"/>			<!-- Progress bar -->
			<RowDefinition Height="Auto"/>			<!-- Progress text -->
			<RowDefinition Height="Auto"/>			<!-- Status -->
		</Grid.RowDefinitions>

		<!-- Model Depth -->
		<GroupBox  Grid.Row="0" Header="Model Depth" Margin="5">
			<StackPanel>
				<RadioButton Content="Branch"
                     IsChecked="{Binding ModelDepth, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Branch}" />

				<RadioButton Content="All"
                     IsChecked="{Binding ModelDepth, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=All}" />
			</StackPanel>
		</GroupBox>

		<!-- Overwrite -->
		<GroupBox Grid.Row="1" Header="Overwrite" Margin="5">
			<StackPanel>
				<RadioButton Content="Yes"
                     IsChecked="{Binding Overwrite, Mode=TwoWay}" />

				<RadioButton Content="Skip"
                     IsChecked="{Binding Overwrite, Converter={StaticResource InverseBooleanConverter}, Mode=TwoWay}" />
			</StackPanel>
		</GroupBox>

		<!-- Get Model Collections -->
		<StackPanel Grid.Row="2" Orientation="Vertical" Margin="0">

			<!-- ✅ COLLECTION A -->
			<GroupBox Header="Collection A" Margin="5">
				<StackPanel Orientation="Horizontal" Margin="5">
					<Button Content="Capture Selection"
						Width="120"
						Margin="5"
						Command="{Binding CaptureSelectionACommand}" />

					<Button Content="Clear"
						Width="80"
						Margin="5"
						Command="{Binding ClearSelectionACommand}" />

					<Button Content="Show"
						Width="70"
						Margin="5"
						Command="{Binding ShowSelectionACommand}" />

					<TextBlock Margin="10,0,0,0"
						VerticalAlignment="Center"
						Text="{Binding CollectionACount, StringFormat='Items: {0}'}"/>
				</StackPanel>
			</GroupBox>

			<!-- ✅ COLLECTION B -->
			<GroupBox Header="Collection B" Margin="5">
				<StackPanel Orientation="Horizontal" Margin="5">
					<Button Content="Capture Selection"
						Width="120"
						Margin="5"
						Command="{Binding CaptureSelectionBCommand}" />

					<Button Content="Clear"
						Width="80"
						Margin="5"
						Command="{Binding ClearSelectionBCommand}" />

					<Button Content="Show"
						Width="70"
						Margin="5"
						Command="{Binding ShowSelectionBCommand}" />

					<TextBlock Margin="10,0,0,0"
						VerticalAlignment="Center"
						Text="{Binding CollectionBCount, StringFormat='Items: {0}'}"/>
				</StackPanel>
			</GroupBox>

		</StackPanel>


		<!-- Write Section -->
		<GroupBox Grid.Row="3" Header="Write Property" Margin="5">
			<Grid Margin="5">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="140"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!-- Write Button -->
				<Button Grid.Row="0" Grid.Column="0"
                Content="Write to Selected"
                Width="120"
                Margin="0,0,10,5"
                Command="{Binding WriteTestCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>

				<!-- Property Tab -->
				<Button Grid.Row="0" Grid.Column="1"
                Margin="-5,0,5,5"
                Command="{Binding EditPropertyTabCommand}">
					<TextBlock>
                <Run Text="Tab: "/>
                <Run Text="{Binding PropertyTabName, TargetNullValue='[Set]'}"/>
					</TextBlock>
				</Button>

				<!-- Property Name -->
				<Button Grid.Row="1" Grid.Column="1"
                Margin="-5,0,5,5"
                Command="{Binding EditPropertyNameCommand}">
					<TextBlock>
                <Run Text="Name: "/>
                <Run Text="{Binding PropertyName, TargetNullValue='[Set]'}"/>
					</TextBlock>
				</Button>

				<!-- Property Value -->
				<Button Grid.Row="2" Grid.Column="1"
				Margin="-5,0,5,5"		
                Command="{Binding EditPropertyValueCommand}">
					<TextBlock>
                <Run Text="Value: "/>
                <Run Text="{Binding PropertyValue, TargetNullValue='[Set]'}"/>
					</TextBlock>
				</Button>

			</Grid>
		</GroupBox>

		<!-- Get Synchro Data button -->
		<Button Grid.Row="4"
            Content="Get Synchro Data"
            Width="160"
            Margin="0,10,0,0"
            Command="{Binding GetSynchroDataCommand}"
				IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>

		<Button Grid.Row="5"
			Content="Transfer RID A → B"
			Width="160"
			Margin="0,10,0,0"
			Command="{Binding TransferRidCommand}"
				IsEnabled="{Binding CanTransferRid}" />
		
		
		<!-- Progress bar -->
		<ProgressBar Grid.Row="6"
				 Height="18"
				 Margin="0,10,0,0"
				 Minimum="0"
				 Maximum="100"
				 Value="{Binding ProgressPercent}" />

		<!-- Progress text -->
		<TextBlock Grid.Row="7"
			   Margin="0,6,0,0"
			   Text="{Binding ProgressText}" />

		<!-- Status -->
		<TextBlock Grid.Row="8"
               Margin="0,10,0,0"
               Text="{Binding Status}" />


	</Grid>
	
</UserControl>
