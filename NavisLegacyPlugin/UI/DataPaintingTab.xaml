<UserControl x:Class="NavisLegacyPlugin.UI.DataPaintingTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NavisLegacyPlugin"
             xmlns:conv="clr-namespace:NavisLegacyPlugin.Converters"
			 DataContext="{Binding DataPainting}">

	<UserControl.Resources>
		<conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
		<conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
	</UserControl.Resources>


	<Grid Margin="10">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>			<!-- Model Depth -->
			<RowDefinition Height="Auto"/>			<!-- Overwrite -->
			<RowDefinition Height="Auto"/>			<!-- Get Model Collections -->
			<RowDefinition Height="Auto"/>			<!-- Write Test -->
			<RowDefinition Height="Auto"/>			<!-- GetData -->
			<RowDefinition Height="Auto"/>			<!-- Transfer RID -->
			<RowDefinition Height="Auto"/>			<!-- Progress bar -->
			<RowDefinition Height="Auto"/>			<!-- Progress text -->
			<RowDefinition Height="Auto"/>			<!-- Status -->
		</Grid.RowDefinitions>

		<!-- Model Depth -->
		<GroupBox  Grid.Row="0" Header="Model Depth" Margin="5">
			<StackPanel>
				<RadioButton Content="Branch"
                     IsChecked="{Binding ModelDepth, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Branch}" />

				<RadioButton Content="All"
                     IsChecked="{Binding ModelDepth, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=All}" />
			</StackPanel>
		</GroupBox>

		<!-- Overwrite -->
		<GroupBox Grid.Row="1" Header="Overwrite" Margin="5">
			<StackPanel>
				<RadioButton Content="Yes"
                     IsChecked="{Binding Overwrite, Mode=TwoWay}" />

				<RadioButton Content="Skip"
                     IsChecked="{Binding Overwrite, Converter={StaticResource InverseBooleanConverter}, Mode=TwoWay}" />
			</StackPanel>
		</GroupBox>

		<!-- Get Model Collections -->
		<StackPanel Grid.Row="2" Orientation="Vertical" Margin="5">

			<!-- ✅ COLLECTION A -->
			<GroupBox Header="Collection A" Margin="5">
				<StackPanel Orientation="Horizontal" Margin="5">
					<Button Content="Capture Selection"
						Width="120"
						Margin="5"
						Command="{Binding CaptureSelectionACommand}" />

					<Button Content="Clear"
						Width="80"
						Margin="5"
						Command="{Binding ClearSelectionACommand}" />

					<Button Content="Show"
						Width="70"
						Margin="5"
						Command="{Binding ShowSelectionACommand}" />

					<TextBlock Margin="10,0,0,0"
						VerticalAlignment="Center"
						Text="{Binding CollectionACount, StringFormat='Items: {0}'}"/>
				</StackPanel>
			</GroupBox>

			<!-- ✅ COLLECTION B -->
			<GroupBox Header="Collection B" Margin="5">
				<StackPanel Orientation="Horizontal" Margin="5">
					<Button Content="Capture Selection"
						Width="120"
						Margin="5"
						Command="{Binding CaptureSelectionBCommand}" />

					<Button Content="Clear"
						Width="80"
						Margin="5"
						Command="{Binding ClearSelectionBCommand}" />

					<Button Content="Show"
						Width="70"
						Margin="5"
						Command="{Binding ShowSelectionBCommand}" />

					<TextBlock Margin="10,0,0,0"
						VerticalAlignment="Center"
						Text="{Binding CollectionBCount, StringFormat='Items: {0}'}"/>
				</StackPanel>
			</GroupBox>

		</StackPanel>


		<!-- Write Test -->
		<Button Grid.Row="3"
            Content="Write Test Property"
            Width="160"
            Command="{Binding WriteTestCommand}"
				IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}	}"/>

		<!-- Get Synchro Data button -->
		<Button Grid.Row="4"
            Content="Get Synchro Data"
            Width="160"
            Margin="0,10,0,0"
            Command="{Binding GetSynchroDataCommand}"
				IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}	}"/>

		<Button Grid.Row="5"
			Content="Transfer RID A → B"
			Width="160"
			Margin="0,10,0,0"
			Command="{Binding TransferRidCommand}"
				IsEnabled="{Binding CanTransferRid}" />
		
		
		<!-- Progress bar -->
		<ProgressBar Grid.Row="6"
				 Height="18"
				 Margin="0,10,0,0"
				 Minimum="0"
				 Maximum="100"
				 Value="{Binding ProgressPercent}" />

		<!-- Progress text -->
		<TextBlock Grid.Row="7"
			   Margin="0,6,0,0"
			   Text="{Binding ProgressText}" />

		<!-- Status -->
		<TextBlock Grid.Row="8"
               Margin="0,10,0,0"
               Text="{Binding Status}" />


	</Grid>
	
</UserControl>
