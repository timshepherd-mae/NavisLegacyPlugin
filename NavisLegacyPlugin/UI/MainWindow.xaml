<Window x:Class="NavisLegacyPlugin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add-in Executed"
        Width="300"
        Height="150"
        WindowStartupLocation="CenterOwner">

	<Grid Margin="10">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!-- ===================== -->
		<!-- Selection A -->
		<!-- ===================== -->
		<Grid Grid.Column="0" Margin="0,0,5,0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<StackPanel Orientation="Horizontal" Margin="0,0,0,5">
				<CheckBox
                Content="Include sub-objects"
                IsChecked="{Binding GeometryA.IncludeSubObjects}" />

				<Button
                Content="Get Geometry (A)"
                Margin="10,0,0,0"
                Command="{Binding GeometryA.RunCommand}" />
			</StackPanel>

			<DataGrid
                Grid.Row="1"
                ItemsSource="{Binding GeometryA.Results}"
                SelectedItem="{Binding GeometryA.SelectedRow, Mode=TwoWay}"
                AutoGenerateColumns="False"
                CanUserAddRows="False">

				<DataGrid.Columns>
					<DataGridTextColumn
                        Header="GUID"
                        Binding="{Binding ItemGuid}"
                        Width="*" />

					<DataGridTextColumn
                        Header="Fragments"
                        Binding="{Binding FragmentCount}"
                        Width="Auto" />

					<DataGridTextColumn
                        Header="Size X"
                        Binding="{Binding SizeX}"
                        Width="Auto" />

					<DataGridTextColumn
                        Header="Size Y"
                        Binding="{Binding SizeY}"
                        Width="Auto" />

					<DataGridTextColumn
                        Header="Size Z"
                        Binding="{Binding SizeZ}"
                        Width="Auto" />

					<DataGridTextColumn
                        Header="Cen X"
                        Binding="{Binding CenX}"
                        Width="Auto" />

					<DataGridTextColumn
                        Header="Cen Y"
                        Binding="{Binding CenY}"
                        Width="Auto" />

					<DataGridTextColumn
                        Header="Cen Z"
                        Binding="{Binding CenZ}"
                        Width="Auto" />
				</DataGrid.Columns>
				
			</DataGrid>
		</Grid>

		<!-- ===================== -->
		<!-- Selection B -->
		<!-- ===================== -->
		<Grid Grid.Column="1" Margin="5,0,0,0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<StackPanel Orientation="Horizontal" Margin="0,0,0,5">
				<CheckBox
                Content="Include sub-objects"
                IsChecked="{Binding GeometryB.IncludeSubObjects}" />

				<Button
                Content="Get Geometry (B)"
                Margin="10,0,0,0"
                Command="{Binding GeometryB.RunCommand}" />
			</StackPanel>

			<DataGrid
                Grid.Row="1"
                ItemsSource="{Binding GeometryB.Results}"
                SelectedItem="{Binding GeometryB.SelectedRow, Mode=TwoWay}"
                AutoGenerateColumns="False"
                CanUserAddRows="False">

				<DataGrid.Columns>
					<DataGridTextColumn
                        Header="GUID"
                        Binding="{Binding ItemGuid}"
                        Width="*" />

					<DataGridTextColumn
                        Header="Fragments"
                        Binding="{Binding FragmentCount}"
                        Width="Auto" />

					<DataGridTextColumn
                        Header="Size X"
                        Binding="{Binding SizeX}"
                        Width="Auto" />

					<DataGridTextColumn
                        Header="Size Y"
                        Binding="{Binding SizeY}"
                        Width="Auto" />

					<DataGridTextColumn
                        Header="Size Z"
                        Binding="{Binding SizeZ}"
                        Width="Auto" />

					<DataGridTextColumn
                        Header="Cen X"
                        Binding="{Binding CenX}"
                        Width="Auto" />

					<DataGridTextColumn
                        Header="Cen Y"
                        Binding="{Binding CenY}"
                        Width="Auto" />

					<DataGridTextColumn
                        Header="Cen Z"
                        Binding="{Binding CenZ}"
                        Width="Auto" />
				</DataGrid.Columns>
				
			</DataGrid>
		</Grid>
	</Grid>

</Window>