<UserControl x:Class="NavisLegacyPlugin.UI.PurgeRidTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:NavisLegacyPlugin.Converters" DataContext="{Binding DataPainting}">
<UserControl.Resources><conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/></UserControl.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
<TextBlock Text="PURGE RID" FontSize="18" FontWeight="Bold"/><TextBlock Margin="0,4,0,12" TextWrapping="Wrap" Text="Controlled maintenance for user-defined MAE-4D / RID properties. Prepare a candidate population before running a destructive action."/>
<GroupBox Header="Blank RID" Margin="0,0,0,10"><StackPanel Margin="8"><TextBlock TextWrapping="Wrap" Text="Find null, empty, whitespace or literal double-quote RID values. Populated RID values are preserved."/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Find Blank RID Candidates" Width="190" Margin="0,0,8,0" Command="{Binding FindBlankRidCandidatesCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/><Button Content="Purge Blank RID" Width="140" Command="{Binding PurgeBlankRidCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/></StackPanel></StackPanel></GroupBox>
<GroupBox Header="Clear RID" Margin="0,0,0,10"><StackPanel Margin="8"><TextBlock Foreground="DarkRed" FontWeight="Bold" TextWrapping="Wrap" Text="Warning: CLEAR RID removes the RID property even when it contains a populated or valid value."/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Prepare Clear RID" Width="190" Margin="0,0,8,0" Command="{Binding PrepareClearRidCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/><Button Content="CLEAR RID" Width="140" Command="{Binding ClearRidCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/></StackPanel></StackPanel></GroupBox>
<TextBlock Text="{Binding Status}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,6"/><ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="18"/><TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
</StackPanel></ScrollViewer></UserControl>